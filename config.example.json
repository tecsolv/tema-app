    "SET_REPEAT":      { "type": "noteon", "note": 66, "channel": 0 },
    "MUTE":            { "type": "noteon", "note": 67, "channel": 0 },
    "SET_AUTODJ":      { "type": "noteon", "note": 68, "channel": 0 },
